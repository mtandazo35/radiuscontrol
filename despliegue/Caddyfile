{
	admin off
	auto_https disable_redirects

	# Certificados internos al vuelo para cualquier nombre (ver el bloque
	# https:// del final). Caddy exige que algo autorice cada emisión: lo hace
	# el pequeño servidor local del final, que siempre dice que sí. Solo
	# escucha en 127.0.0.1.
	on_demand_tls {
		ask http://127.0.0.1:5556/
	}

	# IP del cliente cuando el panel está detrás de un proxy (NPM, Caddy,
	# Traefik...). Se acepta solo de los orígenes que tienen permitido el 443 en
	# el firewall: el agente de firewall escribe esa lista en /proxies y reinicia
	# este contenedor cuando cambia. Dar paso a un proxy en «Accesos al
	# servidor» basta. Se toma primero X-Real-IP, que el proxy pone con la
	# dirección que ve. Sin la lista (recién instalado), no se acepta de nadie.
	servers {
		import /proxies/*.caddy
		client_ip_headers X-Real-IP X-Forwarded-For
	}
}

(panel) {
	encode gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		-Server
	}

	handle /api/* {
		# La API toma la IP del cliente de esta cabecera: una sola dirección,
		# la que Caddy calculó arriba, nunca la lista que mande el navegador.
		reverse_proxy 127.0.0.1:8080 {
			header_up X-Forwarded-For {client_ip}
		}
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}

# Dirección propia del servidor, con su certificado interno de siempre. Sirve
# también a los proxies que se conectan por IP sin indicar nombre (lo normal).
{$SITIO} {
	tls internal
	import panel
}

# Cualquier otro nombre: el panel responde igual, se llegue por el dominio que
# se llegue o por el proxy que sea. Si la conexión pide un nombre concreto, se
# le emite al momento un certificado interno para él.
https:// {
	tls internal {
		on_demand
	}
	import panel
}

http://127.0.0.1:5556 {
	bind 127.0.0.1
	respond 200
}

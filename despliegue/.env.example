# Ejemplo del archivo .env que genera despliegue/instalar.sh.
# Aquí no va ningún secreto: las contraseñas y la clave maestra se generan en
# despliegue/secrets/ (fuera de git) y llegan a los contenedores como secretos
# de Docker, no como variables de entorno.

# Dirección con la que se abre el panel (la del certificado).
SITIO=https://192.0.2.10

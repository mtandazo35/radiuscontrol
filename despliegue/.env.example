# Ejemplo del archivo .env que genera despliegue/instalar.sh.
# Aquí no va ningún secreto: las contraseñas y la clave maestra se generan en
# despliegue/secrets/ (fuera de git) y llegan a los contenedores como secretos
# de Docker, no como variables de entorno.

# Dirección con la que se abre el panel (la del certificado).
SITIO=https://192.0.2.10

# Opcional. Proxies (NPM, Caddy, Traefik...) de los que se acepta la IP real
# del cliente en X-Real-IP / X-Forwarded-For, separados por espacios. Sin esta
# línea se acepta de cualquiera, para que funcione con cualquier proxy.
# PROXIES_CONFIABLES=192.0.2.20/32

# Dirección de este servidor tal como la ven los routers.
SERVIDOR_RADIUS=192.0.2.10

# Usuario del primer administrador del panel.
ADMIN_USUARIO=admin

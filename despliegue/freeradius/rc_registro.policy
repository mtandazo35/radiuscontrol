# Políticas de RadiusControl para registrar cada autenticación.

rc_metodo {
	if (&request:MS-CHAP2-Response) {
		update control {
			&Tmp-String-0 := "MS-CHAPv2"
		}
	}
	elsif (&request:MS-CHAP-Response) {
		update control {
			&Tmp-String-0 := "MS-CHAPv1"
		}
	}
	elsif (&request:CHAP-Password) {
		update control {
			&Tmp-String-0 := "CHAP"
		}
	}
	elsif (&request:User-Password) {
		update control {
			&Tmp-String-0 := "PAP"
		}
	}
	else {
		update control {
			&Tmp-String-0 := "otro"
		}
	}
}

# Si el registro no se puede escribir, el login sigue su curso: «fail = 1» baja
# la prioridad del fallo y «ok» deja un resultado correcto por encima.
rc_registrar_aceptado {
	rc_metodo
	update control {
		&Tmp-String-1 := "aceptado"
	}
	rc_registro {
		fail = 1
	}
	ok
}

rc_registrar_rechazado {
	rc_metodo
	#  Sin ninguna credencial, o con la clave PAP vacía, es el mismo sondeo que
	#  el de MS-CHAP con la contraseña vacía.
	if ((&control:Tmp-String-0 == "otro") || (&request:User-Password && (&request:User-Password == ""))) {
		update control {
			&Tmp-String-2 := "sondeo"
		}
	}
	update control {
		&Tmp-String-1 := "rechazado"
	}
	rc_registro {
		fail = 1
	}
	ok
}

#  Marca como «sondeo» una respuesta MS-CHAP calculada con la contraseña vacía.
#  Solo se llama cuando la comprobación normal ya falló, y quien la llama
#  rechaza la petición después: no cambia quién entra, solo cómo se registra.
rc_sondeo_mschap {
	update control {
		&NT-Password := 0x31d6cfe0d16ae931b73c59d7e0c089c0
	}
	rc_mschap_vacia {
		reject = 1
		fail = 1
		invalid = 1
		notfound = 1
		noop = 1
		userlock = 1
		handled = 1
	}
	if (ok) {
		update control {
			&Tmp-String-2 := "sondeo"
		}
	}
	#  Lo que haya añadido la segunda comprobación no sale en la respuesta.
	update reply {
		&MS-CHAP2-Success !* ANY
		&MS-MPPE-Recv-Key !* ANY
		&MS-MPPE-Send-Key !* ANY
		&MS-MPPE-Encryption-Policy !* ANY
		&MS-MPPE-Encryption-Types !* ANY
	}
}
